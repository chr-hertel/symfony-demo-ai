<div class="chat-container d-flex flex-column" {{ attributes.defaults(stimulus_controller('chat')) }}>
    <div class="chat-header d-flex align-items-center justify-content-between px-3 py-2 border-bottom bg-light">
        <div class="d-flex align-items-center">
            <twig:ux:icon name="tabler:messages" height="24px" width="24px" />
            <strong class="ms-2">Travel Assistant</strong>
        </div>
        <button {{ live_action('reset') }} class="btn btn-sm btn-outline-secondary">
            Reset Chat
        </button>
    </div>

    <div id="chat-body" class="chat-body flex-grow-1 overflow-auto p-4">
        {% for msg in this.messages %}
            {% if msg.role.value == 'assistant' %}
                <div class="d-flex align-items-start mb-3">
                    <div class="chat-avatar bot-avatar rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <twig:ux:icon name="tabler:messages" height="24px" width="24px" />
                    </div>
                    <div class="bot-message ms-2 p-3 rounded-3 shadow-sm">
                        {{ msg.content|markdown_to_html }}
                    </div>
                </div>
            {% elseif msg.role.value == 'user' %}
                <div class="d-flex align-items-start justify-content-end mb-3">
                    <div class="user-message me-2 p-3 rounded-3 shadow-sm">
                        {% for item in msg.content %}
                            {{ item.text }}
                        {% endfor %}
                    </div>
                    <div class="chat-avatar user-avatar rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                        <twig:ux:icon name="tabler:user" height="24px" width="24px" />
                    </div>
                </div>
            {% endif %}
        {% else %}
            <div id="welcome" class="text-center my-5 py-5">
                <twig:ux:icon name="tabler:world" height="120px" width="120px" class="text-primary opacity-25" />
                <h4 class="mt-4 text-primary">Travel Assistant</h4>
                <p class="text-muted">Ask me anything about European travel destinations.</p>
            </div>
        {% endfor %}

        <div id="loading-message" class="d-none">
            <div class="d-flex align-items-start justify-content-end mb-3">
                <div class="user-message me-2 p-3 rounded-3 shadow-sm"></div>
                <div class="chat-avatar user-avatar rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                    <twig:ux:icon name="tabler:user" height="24px" width="24px" />
                </div>
            </div>
            <div class="d-flex align-items-start mb-3">
                <div class="chat-avatar bot-avatar rounded-circle d-flex align-items-center justify-content-center flex-shrink-0">
                    <twig:ux:icon name="tabler:messages" height="24px" width="24px" />
                </div>
                <div class="bot-message loading ms-2 p-3 rounded-3 shadow-sm">
                    <span class="spinner-border spinner-border-sm me-1"></span>
                    <em>Looking for an answer...</em>
                </div>
            </div>
        </div>
    </div>

    <div class="chat-footer border-top bg-light px-3 py-2">
        <form class="input-group" {{ live_action('submit:prevent') }}>
            <input autofocus id="chat-message"
                   data-model="norender|message"
                   type="text" class="form-control border-0 bg-white" placeholder="Ask about travel in Europe...">
            <button class="btn btn-primary">
                <twig:ux:icon name="tabler:send" height="20px" width="20px" /> Send
            </button>
        </form>
    </div>
</div>
